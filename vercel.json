{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://boom-portfolio-v4-production-final.onrender.com/api/$1"
    },
    {
      "src": "/robots.txt",
      "dest": "https://boom-portfolio-v4-production-final.onrender.com/api/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "https://boom-portfolio-v4-production-final.onrender.com/api/sitemap.xml"
    },
    {
      "src": "/photography/([^/]+)",
      "dest": "/boom_portfolio_v4_production/frontend/album.html?slug=$1"
    },
    {
      "src": "/share/photography/([^/]+)/([^/]+)",
      "dest": "https://boom-portfolio-v4-production-final.onrender.com/share/photography/$1/$2"
    },
    {
      "src": "/album.html",
      "dest": "/boom_portfolio_v4_production/frontend/album.html"
    },
    {
      "src": "/static/uploads/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "/boom_portfolio_v4_production/frontend/static/$1"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
