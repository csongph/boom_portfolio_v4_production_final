SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
ADMIN_EMAILS=you@example.com
CORS_ORIGINS=http://localhost:3000,https://YOUR-PROJECT.vercel.app
FRONTEND_PUBLIC_URL=https://YOUR-PROJECT.vercel.app
BACKEND_PUBLIC_URL=https://YOUR-API.onrender.com

# Google Drive public-folder mode
GOOGLE_DRIVE_API_KEY=

# Optional: connect private Google Drive from Admin
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://YOUR-API.onrender.com/api/integrations/google/callback

# Optional: Admin AI writing assistant
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

TOKEN_ENCRYPTION_KEY=GENERATE_FERNET_KEY
OAUTH_STATE_SECRET=GENERATE_LONG_RANDOM_STRING

# Optional: higher GitHub API limits/private repo metadata
GITHUB_TOKEN=

CONTACT_RATE_LIMIT_PER_10_MIN=5
MAX_GITHUB_REPO_MB=150

# Optional Instagram Graph API feed
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_API_VERSION=v25.0
INSTAGRAM_CACHE_TTL_SECONDS=10800

# Booking email notifications (Gmail SMTP)
# Requires Google 2-Step Verification + a 16-character App Password.
GMAIL_SMTP_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
GMAIL_FROM_NAME=CS PHOTO BY BOOM
BOOKING_NOTIFICATION_EMAIL=yourname@gmail.com

# Optional shared cache/rate limits when Render scales past one instance
REDIS_URL=
