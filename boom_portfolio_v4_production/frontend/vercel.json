{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {"source": "/album", "has": [{"type": "query", "key": "slug", "value": "(?<slug>[A-Za-z0-9-]+)"}], "destination": "/photography/:slug", "permanent": true},
    {"source": "/project", "has": [{"type": "query", "key": "slug", "value": "(?<slug>[A-Za-z0-9-]+)"}], "destination": "/projects/:slug", "permanent": true}
  ],
  "rewrites": [
    {"source": "/api/:path*", "destination": "https://boom-portfolio-v4-production-final.onrender.com/api/:path*"},
    {"source": "/go/:path*", "destination": "https://boom-portfolio-v4-production-final.onrender.com/go/:path*"},
    {"source": "/photography/:slug", "destination": "https://boom-portfolio-v4-production-final.onrender.com/photography/:slug"},
    {"source": "/projects/:slug", "destination": "https://boom-portfolio-v4-production-final.onrender.com/projects/:slug"},
    {"source": "/share/photography/:slug/:photo", "destination": "https://boom-portfolio-v4-production-final.onrender.com/share/photography/:slug/:photo"},
    {"source": "/robots.txt", "destination": "https://boom-portfolio-v4-production-final.onrender.com/api/robots.txt"},
    {"source": "/sitemap.xml", "destination": "https://boom-portfolio-v4-production-final.onrender.com/api/sitemap.xml"}
  ],
  "headers": [
    {"source": "/static/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=86400"}]},
    {"source": "/admin", "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}]},
    {"source": "/(.*)", "headers": [{"key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload"}, {"key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: https:; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self'; connect-src 'self' https://*.supabase.co"}]}
  ]
}
